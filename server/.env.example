NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/nexusflow
CLIENT_ORIGIN=http://localhost:5173
# Applies only when the telemetry time-series collection is first created.
TELEMETRY_RETENTION_SECONDS=
NODE_ACTIVITY_ENABLED=true
LOG_LEVEL=info
REQUEST_SIZE_LIMIT=1mb
# Requests per minute per IP. Ingestion has a separate, much higher budget.
API_RATE_LIMIT=300
INGEST_RATE_LIMIT=6000
# Optional in development; REQUIRED in production. Never commit a real key.
INGEST_API_KEY=
# LOCAL DEMO ONLY. Leave false on an internet-facing deployment.
ALLOW_PRIVATE_WEBHOOKS=false
OUTBOUND_CONCURRENCY=4
OUTBOUND_QUEUE_LIMIT=1000
OUTBOUND_RATE_PER_MINUTE=30
# Three total attempts: initial call, then waits of 250ms and 500ms.
OUTBOUND_RETRY_BASE_MS=250
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=nexusflow@example.com
# Mock receiver and demo default on outside production; explicitly enable in production if desired.
MOCK_RECEIVER_ENABLED=true
DEMO_ENABLED=true
DEMO_WEBHOOK_URL=http://127.0.0.1:5000/api/mock/webhook-receiver
# Optional real MongoDB for integration tests; npm run test:db can start an isolated temporary server.
TEST_MONGODB_URI=
