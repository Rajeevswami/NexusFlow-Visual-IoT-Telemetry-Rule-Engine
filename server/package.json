{
  "name": "nexusflow-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "simulate": "node scripts/simulator.js",
    "engine-check": "node scripts/engineCheck.js",
    "benchmark": "node scripts/benchmark.js",
    "storage-report": "node scripts/storageReport.js",
    "rule-latency": "node scripts/ruleLatency.js",
    "seed": "node scripts/seed.js",
    "test:db": "node scripts/testWithMongo.js",
    "test": "npm run test:unit && npm run test:http",
    "test:unit": "vitest run",
    "test:http": "node --test --import ./test/testEnv.js test/validation.test.js test/integration.test.js test/compilerRoutes.test.js test/websocketChannels.test.js test/websocketActivity.test.js test/security.test.js test/day4Integration.test.js test/apiIntegration.test.js test/e2e.test.js",
    "test:coverage": "vitest run --coverage",
    "test:compiler": "vitest run",
    "bootstrap": "node scripts/seed.js --activate"
  },
  "dependencies": {
    "axios": "^1.21.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.1.0",
    "ipaddr.js": "^2.5.0",
    "mongoose": "^8.24.8",
    "nodemailer": "^10.5.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "rxjs": "^7.8.2",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.11",
    "supertest": "^7.2.2",
    "vitest": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0"
  }
}
