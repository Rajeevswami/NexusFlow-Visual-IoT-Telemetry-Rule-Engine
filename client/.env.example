# Local development (Vite dev server). Browser requests stay same-origin and are
# forwarded to the API by the Vite proxy in vite.config.js.
VITE_API_BASE_URL=/api
VITE_PROXY_TARGET=http://localhost:5000

# Production (Vercel / Netlify / any separately hosted frontend). Set BOTH to the
# deployed backend. The API URL must include the /api prefix; the WebSocket URL must
# use wss:// because the site itself is served over https://.
# VITE_API_URL=https://nexusflow-api.onrender.com/api
# VITE_WS_URL=wss://nexusflow-api.onrender.com/ws
